@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@{
    ViewData["Title"] = L["Access Denied"];
    var returnUrl = Context.Request.Query["ReturnUrl"].FirstOrDefault();
    var requiredPermission = Context.Request.Query["permission"].FirstOrDefault();
}

<div class="min-h-[70vh] flex items-center justify-center px-4 bg-slate-50">
    <div class="max-w-lg w-full text-center">
        <div class="relative mb-8">
            <div class="absolute inset-0 flex items-center justify-center opacity-5">
                <i class="fa-solid fa-shield-halved text-[14rem] text-red-600"></i>
            </div>
            <div class="relative">
                <div class="inline-flex items-center justify-center w-28 h-28 rounded-full bg-gradient-to-br from-red-100 to-rose-50 mb-6 shadow-lg shadow-red-100/50">
                    <i class="fa-solid fa-lock text-5xl text-red-500 animate-pulse"></i>
                </div>
                <h1 class="text-5xl font-black text-slate-900 mb-3 uppercase tracking-tight">@L["Access Denied"]</h1>
                <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-red-50 rounded-full border border-red-100 mb-6">
                    <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                    <span class="text-[10px] font-black text-red-600 uppercase tracking-widest">@L["Security Violation"]</span>
                </div>
            </div>
        </div>

        <p class="text-lg text-slate-600 mb-6 leading-relaxed">
            @L["You do not have the necessary permissions to view this resource. If you believe this is an error, please contact your administrator."]
        </p>

        @if (!string.IsNullOrEmpty(requiredPermission))
        {
            <div class="mb-8 p-5 rounded-2xl bg-amber-50 border border-amber-100 text-left">
                <div class="flex items-start gap-3">
                    <div class="h-10 w-10 rounded-xl bg-amber-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <i class="fa-solid fa-key text-amber-600"></i>
                    </div>
                    <div>
                        <p class="text-xs font-black text-amber-800 uppercase tracking-widest mb-1">@L["Required Permission"]</p>
                        <p class="text-sm font-mono font-bold text-amber-700 bg-amber-100/50 inline-block px-2 py-0.5 rounded-lg">@requiredPermission</p>
                        <p class="text-xs text-amber-600 mt-2">
                            @L["Ask your administrator to assign this permission to your role in the Role Management panel."]
                        </p>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(returnUrl))
        {
            <div class="mb-6 p-4 rounded-2xl bg-slate-100/50 border border-slate-100">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">@L["Requested Page"]</p>
                <p class="text-xs text-slate-500 font-mono truncate">@returnUrl</p>
            </div>
        }

        <div class="space-y-3">
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center justify-center w-full px-6 py-4 bg-slate-900 text-white font-bold rounded-2xl hover:bg-slate-800 transition-all shadow-lg hover:shadow-slate-200 group">
                <i class="fa-solid fa-house mr-3 group-hover:-translate-x-1 transition-transform"></i>
                @L["Return Home"]
            </a>
            <a href="javascript:history.back()" class="inline-flex items-center justify-center w-full px-6 py-4 bg-white text-slate-600 font-bold rounded-2xl border border-slate-200 hover:bg-slate-50 transition-all">
                <i class="fa-solid fa-arrow-left mr-3"></i>
                @L["Go Back"]
            </a>
        </div>

        <div class="mt-12 pt-8 border-t border-slate-200">
            <p class="text-xs text-slate-400 font-medium uppercase tracking-widest flex items-center justify-center gap-2">
                <i class="fa-solid fa-shield-check"></i>
                TicketsPlease RBAC Security Layer
            </p>
        </div>
    </div>
</div>
