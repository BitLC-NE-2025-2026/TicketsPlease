@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

@{
    var consent = Context.Request.Cookies["cookieConsent"];
    var hasConsent = !string.IsNullOrEmpty(consent);
}

@if (!hasConsent)
{
    <div id="cookie-banner" class="fixed bottom-0 inset-x-0 pb-2 sm:pb-5 z-[500] pointer-events-none transform transition-all duration-500 translate-y-0 opacity-100">
        <div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8">
            <div class="p-4 rounded-2xl bg-white shadow-2xl border border-slate-200 backdrop-blur-xl bg-white/90 sm:p-5 flex flex-col sm:flex-row items-center justify-between gap-4 pointer-events-auto">
                <div class="flex items-start gap-4">
                    <div class="h-10 w-10 flex-shrink-0 bg-brand-primary/10 rounded-full flex items-center justify-center text-brand-primary">
                        <i class="fa-solid fa-cookie-bite text-xl"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-black text-slate-900 tracking-tight">@L["We use cookies"]</h3>
                        <p class="mt-1 text-xs text-slate-500 font-medium">
                            @L["This website uses cookies to ensure you get the best experience on our application. We use them for essential functioning and performance analytics."]
                        </p>
                    </div>
                </div>
                <div class="flex flex-shrink-0 items-center justify-center gap-2 w-full sm:w-auto">
                    <button type="button" onclick="acceptCookies()" class="flex-1 sm:flex-none flex items-center justify-center px-5 py-2.5 border border-transparent rounded-xl shadow-sm shadow-brand-primary/20 text-xs font-black text-white bg-brand-primary hover:bg-brand-secondary transition-all">
                        @L["Accept all"]
                    </button>
                    <button type="button" onclick="declineCookies()" class="flex-1 sm:flex-none flex items-center justify-center px-5 py-2.5 border border-slate-200 rounded-xl text-xs font-bold text-slate-600 bg-white hover:bg-slate-50 transition-all">
                        @L["Essentials only"]
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function setConsentCookie(value) {
            const d = new Date();
            d.setTime(d.getTime() + (365 * 24 * 60 * 60 * 1000));
            const expires = "expires=" + d.toUTCString();
            document.cookie = "cookieConsent=" + value + ";" + expires + ";path=/;SameSite=Lax";
            
            // backup to localStorage
            try {
                localStorage.setItem("cookieConsent", value);
            } catch (e) {
                console.warn("Could not write to localStorage:", e);
            }
        }

        function acceptCookies() {
            setConsentCookie("all");
            hideBanner();
        }

        function declineCookies() {
            setConsentCookie("essential");
            hideBanner();
        }

        function hideBanner() {
            const banner = document.getElementById("cookie-banner");
            if (banner) {
                banner.classList.add("translate-y-full", "opacity-0");
                setTimeout(() => {
                    banner.style.display = "none";
                }, 500);
            }
        }
    </script>
}
