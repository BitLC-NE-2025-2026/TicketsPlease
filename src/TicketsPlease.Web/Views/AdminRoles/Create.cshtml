@using TicketsPlease.Web.Controllers
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model EditRoleViewModel
@{
    ViewData["Title"] = L["Create Role"];
    var isCreate = true;
}

<div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex items-center justify-between">
        <a asp-action="Index" class="text-slate-400 hover:text-brand-primary font-bold transition-colors flex items-center">
            <i class="fa-solid fa-arrow-left mr-2"></i> @L["Back to Roles"]
        </a>
        <div class="p-3 bg-violet-500/10 rounded-2xl text-violet-500">
            <i class="fa-solid fa-shield-halved text-2xl"></i>
        </div>
    </div>

    <div class="bg-white rounded-[2.5rem] shadow-xl shadow-slate-200/50 border border-slate-100 p-10 mt-6 relative overflow-hidden">
        <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 bg-violet-500/5 rounded-full blur-3xl"></div>
        <div class="relative z-10">
            <h1 class="text-3xl font-black text-slate-900 mb-2">@L["Create New Role"]</h1>
            <p class="text-slate-500 mb-10 font-medium">@L["Define a new role with specific permissions."]</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-8 p-4 rounded-2xl bg-rose-50 border border-rose-100">
                    <div asp-validation-summary="All" class="text-sm text-rose-600 font-bold"></div>
                </div>
            }

            <form asp-action="Create" method="post" class="space-y-10">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                @* Role Identity Section *@
                <div>
                    <h2 class="text-lg font-black text-slate-800 mb-6 flex items-center gap-2">
                        <i class="fa-solid fa-id-card text-violet-400"></i> @L["Role Identity"]
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label asp-for="Name" class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 px-1">@L["Role Name"]</label>
                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-300 group-focus-within:text-violet-500 transition-colors">
                                    <i class="fa-solid fa-shield-halved"></i>
                                </div>
                                <input asp-for="Name" class="w-full pl-11 pr-4 py-4 rounded-2xl border border-slate-100 bg-slate-50/50 focus:bg-white focus:ring-2 focus:ring-violet-500/20 focus:border-violet-500 outline-none transition-all font-bold text-slate-700" placeholder="@L["e.g. QA Lead"]" />
                            </div>
                            <span asp-validation-for="Name" class="text-xs text-rose-500 font-bold mt-1 px-1"></span>
                        </div>

                        <div>
                            <label asp-for="Description" class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 px-1">@L["Description"]</label>
                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-300 group-focus-within:text-violet-500 transition-colors">
                                    <i class="fa-solid fa-align-left"></i>
                                </div>
                                <input asp-for="Description" class="w-full pl-11 pr-4 py-4 rounded-2xl border border-slate-100 bg-slate-50/50 focus:bg-white focus:ring-2 focus:ring-violet-500/20 focus:border-violet-500 outline-none transition-all font-bold text-slate-700" placeholder="@L["Brief description of this role"]" />
                            </div>
                            <span asp-validation-for="Description" class="text-xs text-rose-500 font-bold mt-1 px-1"></span>
                        </div>
                    </div>
                </div>

                @* Permissions Section *@
                <div>
                    <h2 class="text-lg font-black text-slate-800 mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-key text-emerald-400"></i> @L["Permissions"]
                    </h2>
                    <p class="text-xs text-slate-400 mb-6">@L["Select the permissions this role should have. Page permissions control access to UI sections. Function permissions control specific actions."]</p>

                    <div class="space-y-8">
                        @foreach (var group in Model.AllPermissions)
                        {
                            <div class="border border-slate-100 rounded-2xl overflow-hidden">
                                <div class="bg-slate-50/80 px-6 py-4 flex items-center justify-between border-b border-slate-100">
                                    <div class="flex items-center gap-3">
                                        @{
                                            var groupIcon = group.Key switch {
                                                "Pages" => "fa-solid fa-browser",
                                                "Tickets" => "fa-solid fa-ticket",
                                                "Projects" => "fa-solid fa-diagram-project",
                                                "Teams" => "fa-solid fa-users",
                                                "Users" => "fa-solid fa-user-shield",
                                                "Reports" => "fa-solid fa-chart-bar",
                                                _ => "fa-solid fa-puzzle-piece"
                                            };
                                            var groupColor = group.Key switch {
                                                "Pages" => "text-blue-500",
                                                "Tickets" => "text-amber-500",
                                                "Projects" => "text-emerald-500",
                                                "Teams" => "text-indigo-500",
                                                "Users" => "text-rose-500",
                                                "Reports" => "text-violet-500",
                                                _ => "text-slate-500"
                                            };
                                        }
                                        <i class="@groupIcon @groupColor"></i>
                                        <span class="text-sm font-black text-slate-700 uppercase tracking-wider">@group.Key</span>
                                        <span class="text-[9px] bg-slate-200 text-slate-500 px-2 py-0.5 rounded-full font-bold">@group.Value.Count</span>
                                    </div>
                                    <label class="flex items-center gap-2 cursor-pointer group">
                                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider group-hover:text-violet-500 transition-colors">@L["Select All"]</span>
                                        <input type="checkbox" class="permission-group-toggle h-4 w-4 rounded border-slate-300 text-violet-500 focus:ring-violet-500/20 cursor-pointer"
                                               data-group="@group.Key"
                                               onchange="togglePermissionGroup(this, '@group.Key')" />
                                    </label>
                                </div>
                                <div class="p-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    @foreach (var perm in group.Value)
                                    {
                                        <label class="relative flex items-start p-4 rounded-xl border border-slate-100 bg-white hover:bg-violet-50/50 hover:border-violet-200/50 transition-all cursor-pointer group/perm">
                                            <input type="checkbox" name="SelectedPermissions" value="@perm.Key"
                                                   class="permission-check h-5 w-5 rounded-lg border-slate-200 text-violet-500 focus:ring-violet-500/20 mt-0.5 transition-all"
                                                   data-group="@group.Key" />
                                            <div class="ml-3 min-w-0">
                                                <span class="text-sm font-bold text-slate-700 group-hover/perm:text-slate-900 transition-colors block">@perm.DisplayName</span>
                                                <span class="text-[10px] text-slate-400 block mt-0.5">@perm.Description</span>
                                                <span class="text-[8px] text-slate-300 font-mono mt-1 block">@perm.Key</span>
                                            </div>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* Submit *@
                <div class="pt-6 border-t border-slate-50 flex items-center justify-between">
                    <div class="text-xs text-slate-400">
                        <span class="permission-counter font-bold text-violet-500">0</span> @L["permissions selected"]
                    </div>
                    <div class="flex items-center gap-4">
                        <a asp-action="Index" class="px-8 py-4 rounded-full font-bold text-slate-400 hover:text-slate-600 transition-colors">
                            @L["Cancel"]
                        </a>
                        <button type="submit" class="px-10 py-4 bg-slate-900 hover:bg-violet-600 text-white rounded-full font-black shadow-xl shadow-slate-900/10 hover:shadow-violet-500/20 transition-all transform hover:-translate-y-1 active:scale-95">
                            <i class="fa-solid fa-shield-check mr-2"></i>
                            @L["Create Role"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePermissionGroup(toggle, groupName) {
            const checkboxes = document.querySelectorAll(`.permission-check[data-group="${groupName}"]`);
            checkboxes.forEach(cb => cb.checked = toggle.checked);
            updatePermissionCounter();
        }

        function updatePermissionCounter() {
            const count = document.querySelectorAll('.permission-check:checked').length;
            document.querySelectorAll('.permission-counter').forEach(el => el.textContent = count);
        }

        function updateGroupToggles() {
            document.querySelectorAll('.permission-group-toggle').forEach(toggle => {
                const group = toggle.dataset.group;
                const all = document.querySelectorAll(`.permission-check[data-group="${group}"]`);
                const checked = document.querySelectorAll(`.permission-check[data-group="${group}"]:checked`);
                toggle.checked = all.length === checked.length;
                toggle.indeterminate = checked.length > 0 && checked.length < all.length;
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            updatePermissionCounter();
            updateGroupToggles();
            document.querySelectorAll('.permission-check').forEach(cb => {
                cb.addEventListener('change', () => {
                    updatePermissionCounter();
                    updateGroupToggles();
                });
            });
        });
    </script>
}
