@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

@{
    var consent = Context.Request.Cookies["cookieConsent"];
    var hasConsent = !string.IsNullOrEmpty(consent);
}

@if (!hasConsent)
{
    <div id="cookie-banner" class="fixed bottom-4 right-4 max-w-md w-[calc(100%-2rem)] z-[9999] pointer-events-auto transform transition-all duration-500 translate-y-0 opacity-100">
        <div class="p-5 rounded-2xl bg-white shadow-2xl border border-slate-200 backdrop-blur-xl bg-white/95 flex flex-col gap-4">
            <div class="flex items-start gap-4">
                <div class="h-10 w-10 flex-shrink-0 bg-brand-primary/10 rounded-full flex items-center justify-center text-brand-primary">
                    <i class="fa-solid fa-cookie-bite text-xl"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <h3 class="text-sm font-black text-slate-900 tracking-tight">@L["We use cookies"]</h3>
                    <p class="mt-1 text-xs text-slate-500 font-medium leading-relaxed">
                        @L["This website uses cookies to ensure you get the best experience on our application. We use them for essential functioning and performance analytics."]
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3 w-full">
                <button type="button" onclick="acceptCookies()" class="flex-1 flex items-center justify-center px-4 py-2.5 border border-transparent rounded-xl shadow-sm shadow-brand-primary/20 text-xs font-black text-white bg-brand-primary hover:bg-brand-secondary transition-all cursor-pointer">
                    @L["Accept all"]
                </button>
                <button type="button" onclick="declineCookies()" class="flex-1 flex items-center justify-center px-4 py-2.5 border border-slate-200 rounded-xl text-xs font-bold text-slate-600 bg-white hover:bg-slate-50 transition-all cursor-pointer">
                    @L["Essentials only"]
                </button>
            </div>
        </div>
    </div>

    <script>
        function setConsentCookie(value) {
            const d = new Date();
            d.setTime(d.getTime() + (365 * 24 * 60 * 60 * 1000));
            const expires = "expires=" + d.toUTCString();
            document.cookie = "cookieConsent=" + value + ";" + expires + ";path=/;SameSite=Lax";
            
            // backup to localStorage
            try {
                localStorage.setItem("cookieConsent", value);
            } catch (e) {
                console.warn("Could not write to localStorage:", e);
            }
        }

        function acceptCookies() {
            setConsentCookie("all");
            hideBanner();
        }

        function declineCookies() {
            setConsentCookie("essential");
            hideBanner();
        }

        function hideBanner() {
            const banner = document.getElementById("cookie-banner");
            if (banner) {
                banner.classList.add("translate-y-full", "opacity-0");
                setTimeout(() => {
                    banner.style.display = "none";
                }, 500);
            }
        }
    </script>
}
